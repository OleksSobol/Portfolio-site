---
import { Image } from "astro:assets";

export interface Props {
  title: string;
  img?: string;
  desc?: string;
  url?: string;
  badge?: string;
  tags?: string[];
  target?: string;
}

const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
const tag_url = url ? url.split("/").slice(0, -1).join("/") + "/tag" : "";
const hasLink = Boolean(url && url !== "#");
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<article
  class="relative rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="max-w-full md:max-w-[13rem] rounded-lg"
        />
      )
    }
    <div class="grow w-full">
      <h3 class="text-xl font-bold">
        {
          hasLink ? (
            <a href={url} target={target} rel={rel} class="after:absolute after:inset-0">
              {title}
            </a>
          ) : (
            title
          )
        }
        {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
      </h3>
      {desc && <p class="py-1 text-base">{desc}</p>}
      {
        tags && tags.length > 0 && (
          <div class="card-actions justify-end relative z-10">
            {tags.map((tag) => (
              <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>
