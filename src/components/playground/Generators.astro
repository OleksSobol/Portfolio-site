  function generateKvMap(varName, format, alignArrows, count) {
    const mapItems = [
      { k: 'draft', v: 'Draft' },
      { k: 'pending', v: 'Pending Review' },
      { k: 'approved', v: 'Approved' },
      { k: 'processed', v: 'Processed' },
      { k: 'rejected', v: 'Rejected' },
      { k: 'archived', v: 'Archived' },
      { k: 'closed', v: 'Closed' }
    ].slice(0, Math.min(count, 7));

    let maxK = 0;
    mapItems.forEach(item => { if (item.k.length > maxK) maxK = item.k.length; });

    const isShort = format !== 'php-classic';
    const lines = [];
    lines.push('// Lookup / Dropdown Key-Value Options Map');
    lines.push(`${varName} = ${isShort ? '[' : 'array('}`);
    mapItems.forEach(item => {
      const sp = alignArrows ? ' '.repeat(Math.max(0, maxK - item.k.length)) : '';
      lines.push(`    '${item.k}'${sp} => '${item.v}',`);
    });
    lines.push(isShort ? '];' : ');');

    const codeStr = lines.join('\n');
    renderOutputCode(codeStr, mapItems.length);
    updatePreviewTable(mapItems.map(i => ({ key: i.k, value: i.v })));
  }

  function buildCsvString(records) {
    if (!records.length) return '';
    const headers = Object.keys(records[0]);
    const lines = [headers.join(',')];
    records.forEach(r => {
      const row = headers.map(h => {
        const v = r[h];
        if (typeof v === 'string' && (v.includes(',') || v.includes('"'))) {
          return `"${v.replace(/"/g, '""')}"`;
        }
        return v;
      });
      lines.push(row.join(','));
    });
    return lines.join('\n');
  }

  function renderOutputCode(codeStr, rowsCount) {
    const pre = document.getElementById('dataCodePre');
    const statsEl = document.getElementById('genDataStats');
    if (pre) pre.textContent = codeStr;
    if (statsEl) {
      const bytes = new Blob([codeStr]).size;
      statsEl.textContent = `${rowsCount} rows \u2022 ${bytes} bytes`;
    }
  }

  function updatePreviewTable(records) {
    const head = document.getElementById('genPreviewTableHead');
    const body = document.getElementById('genPreviewTableBody');
    if (!head || !body) return;

    if (!records.length) {
      head.innerHTML = '';
      body.innerHTML = '<tr><td class="text-center text-base-content/50">No data generated</td></tr>';
      return;
    }

    const keys = Object.keys(records[0]);
    head.innerHTML = `<tr><th class="w-8">#</th>${keys.map(k => `<th>${k}</th>`).join('')}</tr>`;

    body.innerHTML = records.map((rec, i) => {
      return `<tr>
        <td class="font-mono text-base-content/50">${i + 1}</td>
        ${keys.map(k => {
          let val = rec[k];
          if (typeof val === 'boolean') {
            return `<td><span class="badge badge-xs ${val ? 'badge-success' : 'badge-ghost'}">${val}</span></td>`;
          }
          if (typeof val === 'number') {
            return `<td class="font-mono text-right">${val.toLocaleString()}</td>`;
          }
          return `<td>${val}</td>`;
        }).join('')}
      </tr>`;
    }).join('');
  }

  function copyDataOutput() {
    const code = document.getElementById('dataCodePre')?.textContent || '';
    if (!code) return;

    navigator.clipboard.writeText(code).then(() => {
      const btnText = document.getElementById('btnCopyDataText');
      const btn = document.getElementById('btnCopyDataOutput');
      if (btnText) btnText.textContent = 'Copied! ✓';
      if (btn) btn.classList.add('btn-outline');

      setTimeout(() => {
        if (btnText) btnText.textContent = 'Copy Code';
        if (btn) btn.classList.remove('btn-outline');
      }, 2000);
    });
  }

  function downloadDataFile() {
    const code = document.getElementById('dataCodePre')?.textContent || '';
    if (!code) return;

    const format = document.getElementById('genOutputFormat')?.value || 'php-array';
    let ext = 'php';
    let mime = 'text/plain';

    if (format === 'json') {
      ext = 'json';
      mime = 'application/json';
    } else if (format === 'js') {
      ext = 'js';
    } else if (format === 'csv') {
      ext = 'csv';
      mime = 'text/csv';
    }

    const filename = `sample_data_${Date.now()}.${ext}`;
    const blob = new Blob([code], { type: `${mime};charset=utf-8` });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    URL.revokeObjectURL(link.href);
  }

