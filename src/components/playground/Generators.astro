  // Generate the PHPUnit Test Class
  function generatePhpUnitTest() {
    const framework = document.getElementById('phpunitFramework')?.value || 'phpunit-attributes';
    const subjectClass = (document.getElementById('phpunitSubjectClass')?.value || 'SalesReceiptsAnalysis').trim();
    let testClass = (document.getElementById('phpunitTestClass')?.value || subjectClass + 'Test').trim();
    if (!testClass.endsWith('Test') && framework !== 'pest') testClass += 'Test';

    const namespace = (document.getElementById('phpunitNamespace')?.value || 'Tests\\Unit').trim();
    const strictTypes = document.getElementById('phpunitStrictTypes')?.checked ?? true;
    const includeSetup = document.getElementById('phpunitIncludeSetup')?.checked ?? true;
    const includeDataProvider = document.getElementById('phpunitIncludeDataProvider')?.checked ?? true;
    const includeException = document.getElementById('phpunitIncludeException')?.checked ?? false;

    let testCode = '';

    if (framework === 'pest') {
      testCode = buildPestTestString({
        subjectClass,
        namespace,
        strictTypes,
        includeSetup,
        includeDataProvider,
        includeException,
        mocks: phpunitMocks,
        methods: phpunitMethods,
        dpRows: customDataProviderRows
      });
    } else {
      testCode = buildPhpUnitTestClassString({
        framework,
        subjectClass,
        testClass,
        namespace,
        strictTypes,
        includeSetup,
        includeDataProvider,
        includeException,
        mocks: phpunitMocks,
        methods: phpunitMethods,
        dpRows: customDataProviderRows
      });
    }

    const pre = document.getElementById('phpunitCodePre');
    const stats = document.getElementById('phpunitStats');
    if (pre) pre.textContent = testCode;

    if (stats) {
      const lines = testCode.split('\n').length;
      stats.textContent = `${phpunitMethods.length} tests \u2022 ${lines} lines \u2022 PSR-12`;
    }
  }

  function buildPhpUnitTestClassString(cfg) {
    const isAttr = cfg.framework === 'phpunit-attributes';
    const lines = [];

    lines.push('<?php');
    lines.push('');
    if (cfg.strictTypes) {
      lines.push('declare(strict_types=1);');
      lines.push('');
    }

    if (cfg.namespace) {
      lines.push(`namespace ${cfg.namespace};`);
      lines.push('');
    }

    // Imports
    lines.push('use PHPUnit\\Framework\\TestCase;');
    if (isAttr) {
      lines.push('use PHPUnit\\Framework\\Attributes\\Test;');
      if (cfg.includeDataProvider || cfg.methods.some(m => m.type === 'data_provider')) {
        lines.push('use PHPUnit\\Framework\\Attributes\\DataProvider;');
      }
    }
    if (cfg.mocks.length > 0) {
      lines.push('use PHPUnit\\Framework\\MockObject\\MockObject;');
    }
    lines.push(`use App\\Services\\${cfg.subjectClass};`);
    lines.push('');

    // Class definition
    lines.push(`final class ${cfg.testClass} extends TestCase`);
    lines.push('{');

    // Properties
    const subjectProp = cfg.subjectClass.charAt(0).toLowerCase() + cfg.subjectClass.slice(1);
    lines.push(`    private ${cfg.subjectClass} $${subjectProp};`);

    cfg.mocks.forEach(m => {
      lines.push(`    private MockObject&${m.type} $${m.name};`);
    });

    lines.push('');

    // setUp
    if (cfg.includeSetup) {
      lines.push('    protected function setUp(): void');
      lines.push('    {');
      lines.push('        parent::setUp();');

      if (cfg.mocks.length > 0) {
        lines.push('');
        cfg.mocks.forEach(m => {
          lines.push(`        $this->${m.name} = $this->createMock(${m.type}::class);`);
        });
        lines.push('');
        const ctorArgs = cfg.mocks.map(m => `$this->${m.name}`).join(', ');
        lines.push(`        $this->${subjectProp} = new ${cfg.subjectClass}(${ctorArgs});`);
      } else {
        lines.push(`        $this->${subjectProp} = new ${cfg.subjectClass}();`);
      }

      lines.push('    }');
      lines.push('');
    }

    // Test Methods
    cfg.methods.forEach(m => {
      const methodName = m.name.replace(/[^a-zA-Z0-9_]/g, '_');

      if (isAttr) {
        lines.push('    #[Test]');
        if (m.type === 'data_provider') {
          lines.push(`    #[DataProvider('monthlyTotalsDataProvider')]`);
        }
      } else {
        lines.push('    /**');
        lines.push('     * @test');
        if (m.type === 'data_provider') {
          lines.push('     * @dataProvider monthlyTotalsDataProvider');
        }
        lines.push('     */');
      }

      if (m.type === 'data_provider') {
        lines.push(`    public function ${methodName}(string $month, float|int $total, float|int $expected): void`);
        lines.push('    {');
        lines.push('        $this->assertGreaterThan(0, $total);');
        lines.push('        $this->assertSame($expected, $total);');
        lines.push('    }');
      } else if (m.type === 'chart_render') {
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push('        $sampleData = [');
        lines.push("            ['month' => 'Jan', 'total' => 12500],");
        lines.push("            ['month' => 'Feb', 'total' => 18500],");
        lines.push("            ['month' => 'Mar', 'total' => 15500],");
        lines.push('        ];');
        lines.push('');
        lines.push('        $chartConfig = \\App\\Charts\\Echarts::bar()');
        lines.push('            ->setData($sampleData)');
        lines.push("            ->setLabelKey('month')");
        lines.push("            ->setMetrics(['Total Sales' => 'total'])");
        lines.push('            ->render();');
        lines.push('');
        lines.push('        $this->assertIsArray($chartConfig);');
        lines.push("        $this->assertArrayHasKey('chartDimensions', $chartConfig);");
        lines.push("        $this->assertArrayHasKey('chartDataset', $chartConfig);");
        lines.push('    }');
      } else if (m.type === 'ajax_callback') {
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push("        $_SERVER['HTTP_X_REQUESTED_WITH'] = 'xmlhttprequest';");
        lines.push('');
        lines.push("        $isCallback = isset($_SERVER['HTTP_X_REQUESTED_WITH']) && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest';");
        lines.push('');
        lines.push('        $this->assertTrue($isCallback);');
        lines.push('    }');
      } else if (m.type === 'page_config') {
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push(`        $page = $this->${subjectProp}->getPageConfig();`);
        lines.push('');
        lines.push("        $this->assertContains('Administrator', $page['groups']);");
        lines.push("        $this->assertContains('AR', $page['groups']);");
        lines.push("        $this->assertSame('Sales Receipts Analysis Charts', $page['title']);");
        lines.push("        $this->assertSame('view', $page['roles']);");
        lines.push('    }');
      } else if (m.type === 'mock_service') {
        const mockName = cfg.mocks[0]?.name || 'repository';
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push('        $sampleRows = [');
        lines.push("            ['month' => 'Jan', 'total' => 12500],");
        lines.push('        ];');
        lines.push('');
        lines.push(`        $this->${mockName}`);
        lines.push('            ->expects($this->once())');
        lines.push("            ->method('getSalesByPeriod')");
        lines.push("            ->with('2026')");
        lines.push('            ->willReturn($sampleRows);');
        lines.push('');
        lines.push(`        $result = $this->${subjectProp}->getMonthlySummary('2026');`);
        lines.push('        $this->assertCount(1, $result);');
        lines.push('    }');
      } else if (m.type === 'exception') {
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push('        $this->expectException(\\InvalidArgumentException::class);');
        lines.push("        $this->expectExceptionMessage('Invalid period specified');");
        lines.push('');
        lines.push(`        $this->${subjectProp}->getMonthlySummary('');`);
        lines.push('    }');
      } else if (m.type === 'export_flags') {
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push("        $_REQUEST['pdf'] = '1';");
        lines.push("        $isPdf = array_key_exists('pdf', $_REQUEST) && $_REQUEST['pdf'];");
        lines.push('');
        lines.push('        $this->assertTrue((bool)$isPdf);');
        lines.push('    }');
      } else {
        lines.push(`    public function ${methodName}(): void`);
        lines.push('    {');
        lines.push(`        $actual = $this->${subjectProp}->execute();`);
        lines.push('        $this->assertNotNull($actual);');
        lines.push('    }');
      }

      lines.push('');
    });

    // DataProvider implementation
    if (cfg.includeDataProvider || cfg.methods.some(m => m.type === 'data_provider')) {
      lines.push('    /**');
      lines.push('     * @return array<string, array{string, float|int, float|int}>');
      lines.push('     */');
      lines.push('    public static function monthlyTotalsDataProvider(): array');
      lines.push('    {');
      lines.push('        return [');

      if (cfg.dpRows && cfg.dpRows.length > 0) {
        cfg.dpRows.forEach(row => {
          const m = row['month'] || row['label'] || row['name'] || 'Item';
          const t = row['total'] || row['amount'] || row['price'] || 12000;
          lines.push(`            '${String(m).toLowerCase()} sales' => ['${m}', ${t}, ${t}],`);
        });
      } else {
        lines.push("            'january sales'  => ['Jan', 12500, 12500],");
        lines.push("            'february sales' => ['Feb', 18500, 18500],");
        lines.push("            'march sales'    => ['Mar', 15500, 15500],");
      }

      lines.push('        ];');
      lines.push('    }');
      lines.push('');
    }

    lines.push('}');
    return lines.join('\n');
  }

  function buildPestTestString(cfg) {
    const lines = [];

    lines.push('<?php');
    lines.push('');
    if (cfg.strictTypes) {
      lines.push('declare(strict_types=1);');
      lines.push('');
    }

    lines.push('use App\\Charts\\Echarts;');
    lines.push(`use App\\Services\\${cfg.subjectClass};`);
    lines.push('');

    lines.push(`describe('${cfg.subjectClass}', function () {`);

    if (cfg.includeSetup) {
      lines.push('    beforeEach(function () {');
      lines.push('        $this->sampleData = [');
      lines.push("            ['month' => 'Jan', 'total' => 12500],");
      lines.push("            ['month' => 'Feb', 'total' => 18500],");
      lines.push('        ];');
      lines.push(`        $this->subject = new ${cfg.subjectClass}();`);
      lines.push('    });');
      lines.push('');
    }

    cfg.methods.forEach(m => {
      const desc = m.name.replace(/_/g, ' ');

      if (m.type === 'chart_render') {
        lines.push(`    it('${desc}', function () {`);
        lines.push('        $chart = Echarts::bar()');
        lines.push('            ->setData($this->sampleData)');
        lines.push("            ->setLabelKey('month')");
        lines.push("            ->setMetrics(['Total Sales' => 'total'])");
        lines.push('            ->render();');
        lines.push('');
        lines.push('        expect($chart)->toBeArray()');
        lines.push("            ->and($chart)->toHaveKey('chartDimensions')");
        lines.push("            ->and($chart)->toHaveKey('chartDataset');");
        lines.push('    });');
      } else if (m.type === 'data_provider') {
        lines.push(`    it('${desc}', function (string $month, float $total) {`);
        lines.push('        expect($total)->toBeGreaterThan(0)');
        lines.push('            ->and($month)->not->toBeEmpty();');
        lines.push('    })->with([');
        if (cfg.dpRows && cfg.dpRows.length > 0) {
          cfg.dpRows.forEach(r => {
            lines.push(`        ['${r['month'] || 'Jan'}', ${r['total'] || 12500}],`);
          });
        } else {
          lines.push("        ['Jan', 12500],");
          lines.push("        ['Feb', 18500],");
          lines.push("        ['Mar', 15500],");
        }
        lines.push('    ]);');
      } else if (m.type === 'ajax_callback') {
        lines.push(`    it('${desc}', function () {`);
        lines.push("        $_SERVER['HTTP_X_REQUESTED_WITH'] = 'xmlhttprequest';");
        lines.push("        $isCallback = isset($_SERVER['HTTP_X_REQUESTED_WITH']) && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest';");
        lines.push('        expect($isCallback)->toBeTrue();');
        lines.push('    });');
      } else if (m.type === 'page_config') {
        lines.push(`    it('${desc}', function () {`);
        lines.push('        $page = $this->subject->getPageConfig();');
        lines.push("        expect($page['groups'])->toContain('Administrator')");
        lines.push("            ->and($page['groups'])->toContain('AR')");
        lines.push("            ->and($page['title'])->toBe('Sales Receipts Analysis Charts');");
        lines.push('    });');
      } else {
        lines.push(`    it('${desc}', function () {`);
        lines.push('        $result = $this->subject->execute();');
        lines.push('        expect($result)->not->toBeNull();');
        lines.push('    });');
      }
      lines.push('');
    });

    lines.push('});');
    return lines.join('\n');
  }

  function copyPhpUnitTestOutput() {
    const text = document.getElementById('phpunitCodePre')?.textContent || '';
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('btnCopyPhpUnitOutput');
      const btnText = document.getElementById('btnCopyPhpUnitText');
      if (btnText) btnText.textContent = 'Copied! ✓';
      if (btn) btn.classList.add('btn-outline');

      setTimeout(() => {
        if (btnText) btnText.textContent = 'Copy Test';
        if (btn) btn.classList.remove('btn-outline');
      }, 2000);
    });
  }

  function downloadPhpUnitTestFile() {
    const text = document.getElementById('phpunitCodePre')?.textContent || '';
    if (!text) return;

    const testClass = document.getElementById('phpunitTestClass')?.value || 'ExampleTest';
    const filename = `${testClass}.php`;

    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    URL.revokeObjectURL(link.href);
  }

  // ==========================================
  // 3. UUID GENERATOR STATE & LOGIC
  // ==========================================
  function setUuidCount(val) {
    const input = document.getElementById('subUuidCount');
    if (input) input.value = val;
    generateUUIDs();
  }

  function generateUUIDs() {
    const count = Math.min(100, Math.max(1, parseInt(document.getElementById('subUuidCount')?.value || '1')));
    const formatStyle = document.getElementById('subUuidFormatStyle')?.value || 'standard';
    const outputWrap = document.getElementById('subUuidOutputWrap')?.value || 'lines';
    const outputPre = document.getElementById('subUuidOutputPre');
    const status = document.getElementById('subUuidStatus');
    if (!outputPre) return;

    const uuids = [];
    for (let i = 0; i < count; i++) {
      let u = '';
      if (typeof crypto !== 'undefined' && crypto.randomUUID) {
        u = crypto.randomUUID();
      } else {
        u = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
          const r = Math.random() * 16 | 0;
          return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
      }

      if (formatStyle === 'uppercase') {
        u = u.toUpperCase();
      } else if (formatStyle === 'nohyphen') {
        u = u.replace(/-/g, '');
      } else if (formatStyle === 'braces') {
        u = `{${u}}`;
      } else if (formatStyle === 'urn') {
        u = `urn:uuid:${u}`;
      }

      uuids.push(u);
    }

    let result = '';
    if (outputWrap === 'lines') {
      result = uuids.join('\n');
    } else if (outputWrap === 'php') {
      result = `$uuids = [\n    '` + uuids.join("',\n    '") + `',\n];`;
    } else if (outputWrap === 'json') {
      result = JSON.stringify(uuids, null, 2);
    } else if (outputWrap === 'sql') {
      result = `'` + uuids.join(`', '`) + `'`;
    }

    outputPre.textContent = result;
    if (status) status.textContent = `${count} UUID${count === 1 ? '' : 's'} (${formatStyle})`;
  }

  function clearUUID() {
    const input = document.getElementById('subUuidCount');
    const outputPre = document.getElementById('subUuidOutputPre');
    if (input) input.value = '1';
    if (outputPre) outputPre.textContent = '';
    const status = document.getElementById('subUuidStatus');
    if (status) status.textContent = 'Cleared';
  }

  function copyUUIDOutput() {
    const text = document.getElementById('subUuidOutputPre')?.textContent || '';
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('btnCopyUuid');
      if (btn) {
        btn.textContent = 'Copied! ✓';
        btn.classList.add('btn-success');
        setTimeout(() => {
          btn.textContent = 'Copy Result';
          btn.classList.remove('btn-success');
        }, 2000);
      }
    });
  }

  function downloadUuidOutput() {
    const text = document.getElementById('subUuidOutputPre')?.textContent || '';
    if (!text) return;
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `uuids_${Date.now()}.txt`;
    link.click();
    URL.revokeObjectURL(link.href);
  }

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    renderColumnsListUI();
    generateData();
    renderPhpUnitMocksList();
    renderPhpUnitMethodsList();
    generatePhpUnitTest();
  });
</script>
