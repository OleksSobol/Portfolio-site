---
// Markdown to PDF Converter and Document Viewer Component
---

<div class="card bg-base-200 shadow-xl overflow-visible" id="mdPdfConverterApp">
  <div class="card-body p-4 md:p-6">
    <!-- Header Row -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-4 pb-3 border-b border-base-300">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="card-title text-primary text-xl md:text-2xl font-bold flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Markdown to PDF Converter
          </h2>
          <span class="badge badge-sm badge-outline text-xs">Mermaid & Alerts Ready</span>
        </div>
        <p class="text-xs md:text-sm text-base-content/70 mt-1">
          Paste Markdown with Mermaid diagrams, GitHub callouts, code blocks & tables. Preview live and print or export to clean PDF.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
        <button id="btnPrintPdf" class="btn btn-sm btn-primary gap-1 shadow-md hover:shadow-lg transition-all" title="Open native browser print dialog to print or save as vector PDF">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print / Save PDF
        </button>

        <button id="btnDownloadPdf" class="btn btn-sm btn-secondary gap-1 shadow-sm" title="Directly generate and download .pdf file">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span id="downloadPdfLabel">Download PDF</span>
        </button>

        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-sm btn-outline gap-1">
            More
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </label>
          <ul tabindex="0" class="dropdown-content z-20 menu p-2 shadow-xl bg-base-100 rounded-box w-52 text-sm border border-base-300">
            <li><a id="btnCopyHtml">📋 Copy HTML</a></li>
            <li><a id="btnExportMd">💾 Download .md File</a></li>
            <li><a id="btnToggleWide">⛶ Toggle Wide Screen</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Quick Fill & Toolbar Row -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4 bg-base-100 p-3 rounded-lg border border-base-300">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-bold uppercase text-base-content/60">Quick Tools:</span>
        <button id="btnLoadSample" class="btn btn-xs btn-outline btn-accent rounded-full font-medium" title="Load the Accounting MVC & ECharts Architecture Plan">
          ⚡ Load Implementation Plan Sample
        </button>
        <button id="btnPasteClipboard" class="btn btn-xs btn-outline rounded-full">
          📋 Paste Clipboard
        </button>
        <label class="btn btn-xs btn-outline rounded-full cursor-pointer">
          📂 Open .md
          <input type="file" id="fileMdInput" accept=".md,.markdown,.txt" class="hidden" />
        </label>
        <button id="btnClearEditor" class="btn btn-xs btn-ghost text-error rounded-full">
          🗑️ Clear
        </button>
      </div>

      <!-- View & Format Controls -->
      <div class="flex items-center gap-3 flex-wrap">
        <!-- View Mode Toggle -->
        <div class="join">
          <button id="btnViewSplit" class="btn btn-xs join-item btn-active" title="Side-by-side Editor & Preview">Split</button>
          <button id="btnViewPreview" class="btn btn-xs join-item" title="Fullscreen Document Preview">Preview Only</button>
          <button id="btnViewEditor" class="btn btn-xs join-item" title="Editor Only">Editor Only</button>
        </div>

        <!-- Preview Theme -->
        <div class="flex items-center gap-1 text-xs">
          <span class="text-base-content/60">Preview:</span>
          <select id="selectDocTheme" class="select select-bordered select-xs bg-base-100">
            <option value="paper">📄 Paper (Print-White)</option>
            <option value="modern">🌙 Dark / Theme</option>
          </select>
        </div>

        <!-- Paper Size -->
        <div class="flex items-center gap-1 text-xs">
          <span class="text-base-content/60">Paper:</span>
          <select id="selectPaperSize" class="select select-bordered select-xs bg-base-100">
            <option value="a4">A4 (210×297mm)</option>
            <option value="letter">Letter (8.5×11")</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Main Workspace Container -->
    <div id="workspaceGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start">
      
      <!-- LEFT: Editor Pane -->
      <div id="editorPane" class="flex flex-col border border-base-300 rounded-box bg-base-100 overflow-hidden shadow-sm">
        <div class="flex justify-between items-center bg-base-200 px-3 py-2 border-b border-base-300 text-xs">
          <span class="font-semibold text-base-content/70 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Markdown Input
          </span>
          <div class="flex items-center gap-3 text-base-content/60">
            <span id="charWordCount">0 words | 0 chars</span>
            <span class="badge badge-xs badge-success gap-1" id="saveIndicator">Auto-saved</span>
          </div>
        </div>

        <div class="relative flex-1">
          <textarea
            id="markdownTextarea"
            class="textarea w-full h-[650px] font-mono text-sm leading-relaxed p-4 bg-base-100 border-none focus:outline-none resize-y"
            placeholder="Write or paste your markdown here... (Supports # headings, ```mermaid diagrams, > [!NOTE] GitHub alerts, tables, code blocks)"
            spellcheck="false"
          ></textarea>
        </div>
      </div>

      <!-- RIGHT: Document Preview Pane -->
      <div id="previewPane" class="flex flex-col border border-base-300 rounded-box bg-base-100 overflow-hidden shadow-sm">
        <div class="flex justify-between items-center bg-base-200 px-3 py-2 border-b border-base-300 text-xs">
          <div class="flex items-center gap-2">
            <span class="font-semibold text-base-content/70 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              Live Rendered Document
            </span>
            <span id="renderStatusBadge" class="badge badge-xs badge-ghost">Ready</span>
          </div>
          <div class="flex items-center gap-2">
            <button id="btnZoomOut" class="btn btn-ghost btn-xs px-1" title="Zoom out preview">-</button>
            <span id="zoomLabel" class="text-xs font-mono">100%</span>
            <button id="btnZoomIn" class="btn btn-ghost btn-xs px-1" title="Zoom in preview">+</button>
            <button id="btnResetZoom" class="btn btn-ghost btn-xs px-1 text-[10px]" title="Reset zoom">1:1</button>
          </div>
        </div>

        <!-- Scrollable Document Viewport -->
        <div id="previewViewport" class="flex-1 h-[650px] overflow-y-auto overflow-x-auto p-4 md:p-6 bg-base-300/40">
          <!-- The printable sheet container -->
          <div
            id="printableMarkdownDoc"
            class="doc-sheet doc-theme-paper mx-auto p-6 md:p-10 shadow-lg rounded-sm transition-all"
            style="min-height: 100%;"
          >
            <!-- Content will be rendered here -->
            <div id="markdownOutput" class="markdown-body">
              <div class="text-center py-20 text-base-content/50">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-base font-semibold">Your formatted document will appear here</p>
                <p class="text-xs mt-1">Click "⚡ Load Implementation Plan Sample" above or start typing</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Toast Notification -->
<div id="toastNotification" class="toast toast-end toast-bottom z-50 hidden">
  <div class="alert alert-info py-2 px-4 shadow-lg text-sm">
    <span id="toastMessage">Notification</span>
  </div>
</div>

<!-- Required CDN Libraries -->
<script is:inline src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<!-- Highlight.js Themes (Screen & Print) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" />

<style is:global>
  /* ========================================================
     DOCUMENT & TYPOGRAPHY STYLES (SCREEN & PAPER)
     ======================================================== */
  #mdPdfConverterApp .doc-sheet {
    max-width: 850px;
    width: 100%;
    transform-origin: top center;
    transition: transform 0.15s ease, background-color 0.2s ease, color 0.2s ease;
  }

  /* Paper Light Theme (Crisp Document Look) */
  #mdPdfConverterApp .doc-sheet.doc-theme-paper {
    background-color: #ffffff;
    color: #1e293b; /* Slate 800 */
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }

  /* Modern Theme (Follows App Theme) */
  #mdPdfConverterApp .doc-sheet.doc-theme-modern {
    background-color: oklch(var(--b1));
    color: oklch(var(--bc));
    border: 1px solid oklch(var(--b3));
  }

  /* Markdown Typography */
  #mdPdfConverterApp .markdown-body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.65;
    word-wrap: break-word;
  }

  #mdPdfConverterApp .markdown-body h1 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
    letter-spacing: -0.025em;
    color: #0f172a;
  }

  #mdPdfConverterApp .markdown-body h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid #e2e8f0;
    letter-spacing: -0.02em;
    color: #1e293b;
  }

  #mdPdfConverterApp .markdown-body h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: #1e293b;
  }

  #mdPdfConverterApp .markdown-body h4 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.4rem;
    color: #334155;
  }

  #mdPdfConverterApp .markdown-body p {
    margin-top: 0.5rem;
    margin-bottom: 0.85rem;
    line-height: 1.65;
    color: #334155;
  }

  #mdPdfConverterApp .markdown-body ul,
  #mdPdfConverterApp .markdown-body ol {
    margin-top: 0.4rem;
    margin-bottom: 0.85rem;
    padding-left: 1.75rem;
  }

  #mdPdfConverterApp .markdown-body ul {
    list-style-type: disc;
  }

  #mdPdfConverterApp .markdown-body ol {
    list-style-type: decimal;
  }

  #mdPdfConverterApp .markdown-body li {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
    color: #334155;
  }

  #mdPdfConverterApp .markdown-body strong {
    font-weight: 700;
    color: #0f172a;
  }

  #mdPdfConverterApp .markdown-body hr {
    height: 2px;
    padding: 0;
    margin: 1.75rem 0;
    background-color: rgba(148, 163, 184, 0.25);
    border: 0;
  }

  /* Inline Code */
  #mdPdfConverterApp .markdown-body :not(pre) > code {
    padding: 0.2em 0.4em;
    margin: 0 0.15em;
    font-size: 85%;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    background-color: rgba(148, 163, 184, 0.15);
    border-radius: 6px;
    border: 1px solid rgba(148, 163, 184, 0.2);
  }

  /* Code Block Wrappers */
  #mdPdfConverterApp .code-block-wrapper {
    position: relative;
    margin: 1.2rem 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background-color: #1e293b;
  }

  #mdPdfConverterApp .code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #0f172a;
    padding: 6px 12px;
    font-size: 12px;
    font-family: monospace;
    color: #94a3b8;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
  }

  #mdPdfConverterApp .code-copy-btn {
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #cbd5e1;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
  }

  #mdPdfConverterApp .code-copy-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  #mdPdfConverterApp .markdown-body pre {
    margin: 0;
    padding: 12px 16px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.5;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    background-color: #1e293b;
    color: #f8fafc;
  }

  /* Tables */
  #mdPdfConverterApp .table-wrapper {
    overflow-x: auto;
    margin: 1.25rem 0;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  #mdPdfConverterApp .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  #mdPdfConverterApp .markdown-body th {
    background-color: rgba(148, 163, 184, 0.1);
    font-weight: 600;
    padding: 8px 14px;
    border-bottom: 2px solid rgba(148, 163, 184, 0.3);
  }

  #mdPdfConverterApp .markdown-body td {
    padding: 8px 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
  }

  #mdPdfConverterApp .markdown-body tr:last-child td {
    border-bottom: none;
  }

  #mdPdfConverterApp .markdown-body tr:nth-child(even) {
    background-color: rgba(148, 163, 184, 0.04);
  }

  /* GitHub Alerts / Callouts */
  #mdPdfConverterApp .markdown-alert {
    margin: 1.25rem 0;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 4px solid #64748b;
    background-color: rgba(100, 116, 139, 0.08);
  }

  #mdPdfConverterApp .markdown-alert-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 13.5px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 6px;
  }

  #mdPdfConverterApp .markdown-alert-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
  }

  #mdPdfConverterApp .markdown-alert-content {
    font-size: 14px;
    line-height: 1.6;
  }

  #mdPdfConverterApp .markdown-alert-content > p:first-child {
    margin-top: 0;
  }

  #mdPdfConverterApp .markdown-alert-content > p:last-child {
    margin-bottom: 0;
  }

  /* Alert Types */
  #mdPdfConverterApp .markdown-alert-note {
    border-left-color: #2563eb;
    background-color: #eff6ff;
    color: #1e3a8a;
  }
  #mdPdfConverterApp .markdown-alert-note .markdown-alert-header { color: #1d4ed8; }

  #mdPdfConverterApp .markdown-alert-tip {
    border-left-color: #16a34a;
    background-color: #f0fdf4;
    color: #14532d;
  }
  #mdPdfConverterApp .markdown-alert-tip .markdown-alert-header { color: #15803d; }

  #mdPdfConverterApp .markdown-alert-important {
    border-left-color: #7c3aed;
    background-color: #f5f3ff;
    color: #4c1d95;
  }
  #mdPdfConverterApp .markdown-alert-important .markdown-alert-header { color: #6d28d9; }

  #mdPdfConverterApp .markdown-alert-warning {
    border-left-color: #d97706;
    background-color: #fffbeb;
    color: #78350f;
  }
  #mdPdfConverterApp .markdown-alert-warning .markdown-alert-header { color: #b45309; }

  #mdPdfConverterApp .markdown-alert-caution {
    border-left-color: #dc2626;
    background-color: #fef2f2;
    color: #7f1d1d;
  }
  #mdPdfConverterApp .markdown-alert-caution .markdown-alert-header { color: #b91c1c; }

  /* Standard Blockquotes */
  #mdPdfConverterApp .markdown-body blockquote:not(.markdown-alert) {
    margin: 1rem 0;
    padding: 6px 16px;
    border-left: 4px solid rgba(148, 163, 184, 0.4);
    background-color: rgba(148, 163, 184, 0.06);
    border-radius: 4px;
    color: inherit;
    opacity: 0.9;
  }

  /* Mermaid Diagram Wrappers */
  #mdPdfConverterApp .mermaid-diagram-wrap {
    margin: 1.5rem 0;
    padding: 16px;
    border-radius: 8px;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: auto;
  }

  #mdPdfConverterApp .mermaid-diagram-wrap svg {
    max-width: 100%;
    height: auto;
  }

  #mdPdfConverterApp .mermaid-error {
    color: #dc2626;
    background: #fef2f2;
    border: 1px solid #fecaca;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-family: monospace;
    width: 100%;
  }

  /* Task Lists */
  #mdPdfConverterApp .markdown-body input[type="checkbox"] {
    margin-right: 6px;
    accent-color: #2563eb;
    vertical-align: middle;
  }

  /* ========================================================
     PRINT & PDF STYLES (PURE WHITE PAPER, ZERO DARK THEME LEAK)
     ======================================================== */
  @media print {
    html, body {
      background: #ffffff;
      background-color: #ffffff;
      color: #0f172a;
      margin: 0;
      padding: 0;
      width: 100%;
      height: auto;
      overflow: visible;
    }

    /* Hide entire website chrome, headers, sidebars, tabs, toolbars */
    header, footer, aside, .drawer-side, .drawer-toggle,
    #pgTabsContainer, #editorPane, #sharedNoticeBanner, .tabs,
    .navbar, .alert, button, input, select, textarea,
    #mdPdfConverterApp > .card-body > div:first-child,
    #mdPdfConverterApp > .card-body > div:nth-child(2),
    #toastNotification {
      display: none;
    }

    /* Force all parent wrappers to be unconstrained, white, and full width */
    .drawer, .drawer-content, main, #mdPdfConverterApp, .card, .card-body,
    #workspaceGrid, #previewPane, #previewViewport {
      display: block;
      position: static;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
      border: none;
      box-shadow: none;
      background: #ffffff;
      background-color: #ffffff;
      overflow: visible;
      height: auto;
    }

    #mdPdfConverterApp #printableMarkdownDoc {
      display: block;
      position: static;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
      box-shadow: none;
      border: none;
      background: #ffffff;
      background-color: #ffffff;
      color: #0f172a;
      transform: none;
    }

    @page {
      size: A4 portrait;
      margin: 15mm 15mm 15mm 15mm;
    }

    /* Exact print colors */
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Page break optimization */
    h1, h2, h3, h4, h5, h6 {
      page-break-after: avoid;
      break-after: avoid;
      color: #0f172a;
    }

    pre, .code-block-wrapper, table, .table-wrapper, .markdown-alert, .mermaid-diagram-wrap, blockquote {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    tr {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    /* Hide copy button in print */
    .code-copy-btn, .code-block-header {
      background-color: #f1f5f9;
      color: #475569;
      border-color: #cbd5e1;
    }
    .code-copy-btn {
      display: none;
    }

    /* Code blocks in print: clear background, crisp text */
    .code-block-wrapper {
