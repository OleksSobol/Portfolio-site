    .code-block-header {
      background: #f1f5f9;
      padding: 4px 10px;
      font-size: 9pt;
      font-family: monospace;
      color: #475569;
      border-bottom: 1px solid #cbd5e1;
    }
    .code-copy-btn {
      display: none;
    }
    pre {
      margin: 0;
      padding: 10px 14px;
      font-size: 9pt;
      line-height: 1.45;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      background: #f8fafc;
      color: #0f172a;
      white-space: pre-wrap;
      word-break: break-word;
    }
    pre code {
      color: #0f172a;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 12pt 0;
      font-size: 10pt;
    }
    th, td {
      border: 1px solid #cbd5e1;
      padding: 6pt 10pt;
      text-align: left;
    }
    th {
      background-color: #f1f5f9;
      font-weight: 600;
    }
    tr:nth-child(even) td {
      background-color: #f8fafc;
    }
    .markdown-alert {
      margin: 12pt 0;
      padding: 10pt 14pt;
      border-radius: 6px;
      border-left: 4px solid #64748b;
      background-color: #f8fafc;
    }
    .markdown-alert-header {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
      font-size: 9.5pt;
      text-transform: uppercase;
      margin-bottom: 4pt;
    }
    .markdown-alert-icon {
      display: inline-flex;
      width: 14px;
      height: 14px;
    }
    .markdown-alert-note {
      border-left-color: #2563eb;
      background-color: #eff6ff;
      color: #1e3a8a;
    }
    .markdown-alert-note .markdown-alert-header { color: #1d4ed8; }
    .markdown-alert-tip {
      border-left-color: #16a34a;
      background-color: #f0fdf4;
      color: #14532d;
    }
    .markdown-alert-tip .markdown-alert-header { color: #15803d; }
    .markdown-alert-important {
      border-left-color: #7c3aed;
      background-color: #f5f3ff;
      color: #4c1d95;
    }
    .markdown-alert-important .markdown-alert-header { color: #6d28d9; }
    .markdown-alert-warning {
      border-left-color: #d97706;
      background-color: #fffbeb;
      color: #78350f;
    }
    .markdown-alert-warning .markdown-alert-header { color: #b45309; }
    .markdown-alert-caution {
      border-left-color: #dc2626;
      background-color: #fef2f2;
      color: #7f1d1d;
    }
    .markdown-alert-caution .markdown-alert-header { color: #b91c1c; }
    .mermaid-diagram-wrap {
      margin: 14pt 0;
      padding: 10pt;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      display: flex;
      justify-content: center;
    }
    .mermaid-diagram-wrap svg {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>
  ${docContent}
</body>
</html>`);
    frameDoc.close();

    setTimeout(() => {
      printFrame.contentWindow.focus();
      printFrame.contentWindow.print();
    }, 250);
  }

  // Direct PDF Download via html2pdf.js
  function downloadDirectPdf() {
    if (!window.html2pdf || !printableDoc) {
      printDocument();
      return;
    }

    const btnLabel = document.getElementById('downloadPdfLabel');
    if (btnLabel) btnLabel.textContent = 'Generating...';

    // Get document title from first H1 or default
    const firstH1 = printableDoc.querySelector('h1');
    const baseName = firstH1 ? firstH1.innerText.trim().replace(/[^a-zA-Z0-9_-]/g, '_').substring(0, 45) : 'Document';
    const filename = `${baseName}.pdf`;

    const paperFormat = (paperSelect ? paperSelect.value : 'a4') === 'letter' ? 'letter' : 'a4';

    const opt = {
      margin: [12, 12, 12, 12],
      filename: filename,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false },
      jsPDF: { unit: 'mm', format: paperFormat, orientation: 'portrait' },
      pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
    };

    // Temporarily ensure paper theme
    const previousTheme = themeSelect ? themeSelect.value : 'paper';
    applyTheme('paper');

    html2pdf()
      .set(opt)
      .from(printableDoc)
      .save()
      .then(() => {
        showToast('PDF downloaded successfully!');
      })
      .catch((err) => {
        console.error('html2pdf error:', err);
        showToast('Direct download failed, opening browser print...');
        window.print();
      })
      .finally(() => {
        if (btnLabel) btnLabel.textContent = 'Download PDF';
        if (previousTheme !== 'paper') applyTheme(previousTheme);
      });
  }

  // Copy Rendered HTML
  function copyRenderedHtml() {
    if (!output) return;
    navigator.clipboard.writeText(output.innerHTML).then(() => {
      showToast('Rendered HTML copied to clipboard!');
    });
  }

  // Export .md file
  function exportMarkdownFile() {
    const text = textarea ? textarea.value : '';
    if (!text.trim()) {
      showToast('No markdown to export!');
      return;
    }
    const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'document.md';
    a.click();
    URL.revokeObjectURL(url);
    showToast('Markdown file downloaded!');
  }

  // Theme application
  function applyTheme(theme) {
    if (!printableDoc) return;
    if (theme === 'modern') {
      printableDoc.classList.remove('doc-theme-paper');
      printableDoc.classList.add('doc-theme-modern');
    } else {
      printableDoc.classList.remove('doc-theme-modern');
      printableDoc.classList.add('doc-theme-paper');
    }
  }

  // Paper Size styling
  function applyPaperSize(size) {
    if (!printableDoc) return;
    if (size === 'letter') {
      printableDoc.style.maxWidth = '816px'; // 8.5in at 96dpi
    } else {
      printableDoc.style.maxWidth = '794px'; // 210mm at 96dpi (~8.27in)
    }
  }

  // Zoom control
  function setZoom(val) {
    currentZoom = Math.min(Math.max(val, 0.6), 1.6);
    if (printableDoc) {
      printableDoc.style.transform = `scale(${currentZoom})`;
    }
    if (zoomLabel) {
      zoomLabel.textContent = `${Math.round(currentZoom * 100)}%`;
    }
  }

  // Tab key indent handling for textarea
  function handleTextareaKeyDown(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = this.selectionStart;
      const end = this.selectionEnd;
      this.value = this.value.substring(0, start) + '  ' + this.value.substring(end);
      this.selectionStart = this.selectionEnd = start + 2;
      queueRender();
    } else if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
      e.preventDefault();
      printDocument();
    }
  }

  // Toggle View Modes (Split, Preview Only, Editor Only)
  function setViewMode(mode) {
    const editor = document.getElementById('editorPane');
    const preview = document.getElementById('previewPane');
    const grid = document.getElementById('workspaceGrid');

    const btnSplit = document.getElementById('btnViewSplit');
    const btnPrev = document.getElementById('btnViewPreview');
    const btnEdit = document.getElementById('btnViewEditor');

    [btnSplit, btnPrev, btnEdit].forEach(b => b?.classList.remove('btn-active'));

    if (mode === 'preview') {
      editor.classList.add('hidden');
      preview.classList.remove('hidden');
      grid.classList.remove('lg:grid-cols-2');
      grid.classList.add('grid-cols-1');
      btnPrev?.classList.add('btn-active');
    } else if (mode === 'editor') {
      editor.classList.remove('hidden');
      preview.classList.add('hidden');
      grid.classList.remove('lg:grid-cols-2');
      grid.classList.add('grid-cols-1');
      btnEdit?.classList.add('btn-active');
    } else {
      // Split
      editor.classList.remove('hidden');
      preview.classList.remove('hidden');
      grid.classList.remove('grid-cols-1');
      grid.classList.add('lg:grid-cols-2');
      btnSplit?.classList.add('btn-active');
    }
  }

  // Wide screen toggle
  let isWide = false;
  function toggleWideScreen() {
    isWide = !isWide;
    const mainEl = document.querySelector('main');
    if (mainEl) {
      if (isWide) {
        mainEl.classList.remove('lg:max-w-[900px]');
        mainEl.classList.add('max-w-[95vw]', 'w-full');
      } else {
        mainEl.classList.remove('max-w-[95vw]', 'w-full');
        mainEl.classList.add('lg:max-w-[900px]');
      }
    }
    showToast(isWide ? 'Wide screen layout enabled' : 'Standard width restored');
  }

  // Setup Event Listeners
  function initEvents() {
    textarea?.addEventListener('input', queueRender);
    textarea?.addEventListener('keydown', handleTextareaKeyDown);

    document.getElementById('btnPrintPdf')?.addEventListener('click', printDocument);
    document.getElementById('btnDownloadPdf')?.addEventListener('click', downloadDirectPdf);
    document.getElementById('btnCopyHtml')?.addEventListener('click', copyRenderedHtml);
    document.getElementById('btnExportMd')?.addEventListener('click', exportMarkdownFile);
    document.getElementById('btnToggleWide')?.addEventListener('click', toggleWideScreen);

    document.getElementById('btnViewSplit')?.addEventListener('click', () => setViewMode('split'));
    document.getElementById('btnViewPreview')?.addEventListener('click', () => setViewMode('preview'));
    document.getElementById('btnViewEditor')?.addEventListener('click', () => setViewMode('editor'));

    themeSelect?.addEventListener('change', (e) => applyTheme(e.target.value));
    paperSelect?.addEventListener('change', (e) => applyPaperSize(e.target.value));

    document.getElementById('btnZoomIn')?.addEventListener('click', () => setZoom(currentZoom + 0.1));
    document.getElementById('btnZoomOut')?.addEventListener('click', () => setZoom(currentZoom - 0.1));
    document.getElementById('btnResetZoom')?.addEventListener('click', () => setZoom(1.0));

    // Load Sample Button
    document.getElementById('btnLoadSample')?.addEventListener('click', () => {
      if (textarea) {
        textarea.value = USER_SAMPLE_MARKDOWN;
        renderMarkdown();
        showToast('Sample Implementation Plan loaded!');
      }
    });

    // Paste from Clipboard
    document.getElementById('btnPasteClipboard')?.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text && textarea) {
          textarea.value = text;
          renderMarkdown();
          showToast('Pasted from clipboard!');
        }
      } catch (err) {
        showToast('Clipboard access denied. Please paste directly using Ctrl+V');
      }
    });

    // Open .md File
    document.getElementById('fileMdInput')?.addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          if (textarea && evt.target && evt.target.result) {
            textarea.value = evt.target.result;
            renderMarkdown();
            showToast(`Loaded "${file.name}"`);
          }
        };
        reader.readAsText(file);
      }
    });

    // Clear
    document.getElementById('btnClearEditor')?.addEventListener('click', () => {
      if (confirm('Clear editor content?')) {
        if (textarea) textarea.value = '';
        renderMarkdown();
        showToast('Editor cleared');
      }
    });
  }

  // Initialize Component on DOM ready
  function init() {
    initMermaid();
    setupMarked();
    initEvents();

    // Check for saved draft or load simple default
    const savedDraft = localStorage.getItem('md_pdf_converter_draft');
    if (savedDraft && savedDraft.trim() && savedDraft !== USER_SAMPLE_MARKDOWN) {
      textarea.value = savedDraft;
    } else if (textarea) {
      textarea.value = SIMPLE_DEFAULT_MARKDOWN;
    }

    applyPaperSize(paperSelect ? paperSelect.value : 'a4');
    applyTheme(themeSelect ? themeSelect.value : 'paper');
    renderMarkdown();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
