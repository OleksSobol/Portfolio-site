  // Toast Helper
  function showToast(msg) {
    if (!toastNotification || !toastMessage) return;
    toastMessage.textContent = msg;
    toastNotification.classList.remove('hidden');
    setTimeout(() => {
      toastNotification.classList.add('hidden');
    }, 2800);
  }

  let markedConfigured = false;
  let mermaidInitialized = false;

  // Initialize Mermaid
  function initMermaid() {
    if (window.mermaid && !mermaidInitialized) {
      try {
        window.mermaid.initialize({
          startOnLoad: false,
          theme: 'default',
          securityLevel: 'loose',
          fontFamily: 'inherit',
          flowchart: {
            useMaxWidth: true,
            htmlLabels: true,
            curve: 'basis'
          }
        });
        mermaidInitialized = true;
      } catch (e) {
        console.warn('Mermaid initialization warning:', e);
      }
    }
  }

  // Custom Marked Renderer
  function setupMarked() {
    if (!window.marked || markedConfigured) return;

    const customRenderer = {
      // Blockquote Renderer: handles GitHub-style Alerts ([!NOTE], [!TIP], [!IMPORTANT], etc.)
      blockquote(tokenOrQuote) {
        const quote = (typeof tokenOrQuote === 'object' && tokenOrQuote !== null)
          ? (tokenOrQuote.text || tokenOrQuote.raw || '')
          : (tokenOrQuote || '');

        const alertMatch = quote.match(/^\s*(?:<p>)?\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\](?:\s*<br\s*\/?>)?\s*([\s\S]*?)(?:<\/p>)?([\s\S]*)/i);

        if (alertMatch) {
          const type = alertMatch[1].toLowerCase();
          const firstLineRest = alertMatch[2].trim();
          const restOfBody = alertMatch[3] || '';
          const icon = ALERT_ICONS[type] || ALERT_ICONS.note;
          const title = type.charAt(0).toUpperCase() + type.slice(1);

          let body = '';
          if (firstLineRest) {
            body += `<p>${firstLineRest}</p>`;
          }
          if (restOfBody) {
            body += restOfBody;
          }

          return `<div class="markdown-alert markdown-alert-${type}">
            <div class="markdown-alert-header">
              <span class="markdown-alert-icon">${icon}</span>
              <span class="markdown-alert-title">${title}</span>
            </div>
            <div class="markdown-alert-content">${body}</div>
          </div>`;
        }

        return `<blockquote>${quote}</blockquote>`;
      },

      // Code Block Renderer
      code(tokenOrCode, language) {
        let codeStr = '';
        let lang = '';
        if (typeof tokenOrCode === 'object' && tokenOrCode !== null) {
          codeStr = tokenOrCode.text || tokenOrCode.raw || '';
          lang = (tokenOrCode.lang || '').trim().toLowerCase();
        } else {
          codeStr = tokenOrCode || '';
          lang = (language || '').trim().toLowerCase();
        }

        const cleanLang = (lang.split(/\s+/)[0] || '').toLowerCase();

        if (cleanLang === 'mermaid') {
          const diagramId = 'mermaid-block-' + (++mermaidCounter);
          const safeCode = (codeStr || '').replace(/"/g, '&quot;');
          return `<div class="mermaid-diagram-wrap" id="${diagramId}" data-mermaid="${safeCode}">
            <div class="flex items-center gap-2 text-xs text-base-content/50 py-4">
              <span class="loading loading-spinner loading-sm text-primary"></span>
              Rendering Mermaid diagram...
            </div>
          </div>`;
        }

        // Syntax highlighting via highlight.js
        let highlighted = '';
        if (window.hljs && cleanLang && hljs.getLanguage(cleanLang)) {
          try {
            highlighted = hljs.highlight(codeStr, { language: cleanLang, ignoreIllegals: true }).value;
          } catch (e) {
            highlighted = escapeHtml(codeStr);
          }
        } else if (window.hljs) {
          try {
            highlighted = hljs.highlightAuto(codeStr).value;
          } catch (e) {
            highlighted = escapeHtml(codeStr);
          }
        } else {
          highlighted = escapeHtml(codeStr);
        }

        const displayLang = cleanLang || 'code';
        const encodedCode = encodeURIComponent(codeStr);

        return `<div class="code-block-wrapper">
          <div class="code-block-header">
            <span>${displayLang}</span>
            <button class="code-copy-btn" onclick="copySnippet('${encodedCode}', this)">Copy</button>
          </div>
          <pre><code class="hljs ${cleanLang}">${highlighted}</code></pre>
        </div>`;
      }
    };

    try {
      if (typeof marked.use === 'function') {
        marked.use({ renderer: customRenderer });
      }
      if (typeof marked.setOptions === 'function') {
        const legacyRenderer = new marked.Renderer();
        legacyRenderer.code = customRenderer.code;
        legacyRenderer.blockquote = customRenderer.blockquote;
        marked.setOptions({
          renderer: legacyRenderer,
          gfm: true,
          breaks: false
        });
      }
      markedConfigured = true;
    } catch (err) {
      console.warn('Error setting up marked:', err);
    }
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Copy code helper attached to window
  window.copySnippet = function(encoded, btn) {
    try {
      const code = decodeURIComponent(encoded);
      navigator.clipboard.writeText(code).then(() => {
        const oldText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = oldText; }, 1800);
      });
    } catch (e) {
      console.error(e);
    }
  };

  // Main Render Function
  async function renderMarkdown() {
    if (!textarea || !output) return;

    if (!markedConfigured && window.marked) {
      setupMarked();
    }
    if (window.mermaid) {
      initMermaid();
    }

    if (statusBadge) {
      statusBadge.textContent = 'Rendering...';
      statusBadge.className = 'badge badge-xs badge-warning';
    }

    const rawMd = textarea.value;
    updateStats(rawMd);

    // Save to LocalStorage
    try {
      localStorage.setItem('md_pdf_converter_draft', rawMd);
      if (saveIndicator) {
        saveIndicator.textContent = 'Saved';
        saveIndicator.className = 'badge badge-xs badge-success gap-1';
      }
    } catch (e) {}

    if (!rawMd.trim()) {
      output.innerHTML = `
        <div class="text-center py-20 text-base-content/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-base font-semibold">Your formatted document will appear here</p>
          <p class="text-xs mt-1">Click "⚡ Load Implementation Plan Sample" above or start typing</p>
        </div>`;
      if (statusBadge) {
        statusBadge.textContent = 'Ready';
        statusBadge.className = 'badge badge-xs badge-ghost';
      }
      return;
    }

    // Step 1: Parse Markdown to HTML via Marked
    let html = '';
    if (window.marked) {
      html = marked.parse(rawMd);
    } else {
      html = `<pre>${escapeHtml(rawMd)}</pre>`;
    }

    // Step 2: Inject HTML into preview
    output.innerHTML = html;

    // Step 3: Render Mermaid SVGs Asynchronously
    await renderMermaidDiagrams();

    if (statusBadge) {
      statusBadge.textContent = 'Rendered';
      statusBadge.className = 'badge badge-xs badge-success';
    }
  }

  // Asynchronously render all Mermaid blocks
  async function renderMermaidDiagrams() {
    // 1. Await mermaid if CDN is still loading
    if (!window.mermaid) {
      let attempts = 0;
      while (!window.mermaid && attempts < 25) {
        await new Promise(r => setTimeout(r, 100));
        attempts++;
      }
      if (!window.mermaid) return;
    }

    initMermaid();

    // 2. Fallback scanner: convert any <code class="language-mermaid"> that bypassed Marked custom renderer
    const fallbackCodes = output.querySelectorAll('pre > code.language-mermaid, pre > code.lang-mermaid, pre > code[class*="mermaid"]');
    fallbackCodes.forEach((codeEl) => {
      const rawDiagram = codeEl.textContent || '';
      const preEl = codeEl.closest('.code-block-wrapper') || codeEl.closest('pre');
      const wrapEl = document.createElement('div');
      wrapEl.className = 'mermaid-diagram-wrap';
      wrapEl.id = 'mermaid-block-' + (++mermaidCounter);
      wrapEl.setAttribute('data-mermaid', rawDiagram);
      wrapEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-base-content/50 py-4">
        <span class="loading loading-spinner loading-sm text-primary"></span>
        Rendering Mermaid diagram...
      </div>`;
      if (preEl && preEl.parentNode) {
        preEl.parentNode.replaceChild(wrapEl, preEl);
      }
    });

    // 3. Render all .mermaid-diagram-wrap containers
    const containers = output.querySelectorAll('.mermaid-diagram-wrap');
    if (containers.length === 0) return;

    for (let i = 0; i < containers.length; i++) {
      const container = containers[i];
      if (container.querySelector('svg')) continue; // Already rendered

      let code = container.getAttribute('data-mermaid');
      if (!code) {
        code = container.textContent || '';
      }
      code = code
        .replace(/&quot;/g, '"')
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&amp;/g, '&')
        .trim();

      if (!code) continue;

      const uniqueId = 'mermaid-svg-' + Date.now() + '-' + i + '-' + Math.floor(Math.random() * 1000);

      try {
        const { svg } = await window.mermaid.render(uniqueId, code);
        container.innerHTML = svg;
      } catch (err) {
        console.warn('Mermaid render error:', err);
        container.innerHTML = `
          <div class="mermaid-error">
            <strong>Mermaid Syntax Error:</strong> ${escapeHtml(err.message || 'Invalid syntax')}
          </div>`;
      }
    }
  }

  // Update Character and Word Count
  function updateStats(text) {
    if (!countEl) return;
    const chars = text.length;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    countEl.textContent = `${words.toLocaleString()} words | ${chars.toLocaleString()} chars`;
  }

  // Debounced input listener
  function queueRender() {
    if (statusBadge) {
      statusBadge.textContent = 'Typing...';
      statusBadge.className = 'badge badge-xs badge-info';
    }
    if (saveIndicator) {
      saveIndicator.textContent = 'Unsaved...';
      saveIndicator.className = 'badge badge-xs badge-ghost';
    }
    clearTimeout(renderDebounceTimer);
    renderDebounceTimer = setTimeout(renderMarkdown, 250);
  }

  // Native Print / Save to PDF (Uses an isolated iframe for pure white paper output)
  function printDocument() {
    let printFrame = document.getElementById('md-print-iframe');
    if (!printFrame) {
      printFrame = document.createElement('iframe');
      printFrame.id = 'md-print-iframe';
      printFrame.style.position = 'fixed';
      printFrame.style.right = '0';
      printFrame.style.bottom = '0';
      printFrame.style.width = '0';
      printFrame.style.height = '0';
      printFrame.style.border = '0';
      printFrame.style.visibility = 'hidden';
      document.body.appendChild(printFrame);
    }

    const docContent = document.getElementById('markdownOutput').innerHTML;
    const firstH1 = document.querySelector('#markdownOutput h1');
    const docTitle = firstH1 ? firstH1.innerText.trim() : 'Document';
    const paperSize = paperSelect ? paperSelect.value : 'a4';

    const frameDoc = printFrame.contentWindow.document;
    frameDoc.open();
    frameDoc.write(`<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>${escapeHtml(docTitle)}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css" />
  <style>
    @page {
      size: ${paperSize === 'letter' ? 'letter' : 'A4'} portrait;
      margin: 15mm 15mm 15mm 15mm;
    }
    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    html, body {
      background-color: #ffffff;
      color: #0f172a;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.6;
    }
    h1, h2, h3, h4, h5, h6 {
      page-break-after: avoid;
      break-after: avoid;
      color: #0f172a;
    }
    h1 {
      font-size: 22pt;
      font-weight: 800;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 6px;
      margin-top: 0;
      margin-bottom: 12pt;
      letter-spacing: -0.02em;
    }
    h2 {
      font-size: 16pt;
      font-weight: 700;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 4px;
      margin-top: 18pt;
      margin-bottom: 8pt;
      letter-spacing: -0.015em;
    }
    h3 {
      font-size: 13pt;
      font-weight: 600;
      margin-top: 14pt;
      margin-bottom: 6pt;
    }
    h4 {
      font-size: 11pt;
      font-weight: 600;
      margin-top: 10pt;
      margin-bottom: 4pt;
    }
    p {
      margin-top: 0;
      margin-bottom: 9pt;
      color: #334155;
    }
    ul, ol {
      margin-top: 0;
      margin-bottom: 9pt;
      padding-left: 20pt;
    }
    li {
      margin-bottom: 3pt;
      color: #334155;
    }
    hr {
      border: 0;
      border-top: 1px solid #cbd5e1;
      margin: 16pt 0;
    }
    strong {
      font-weight: 700;
      color: #0f172a;
    }
    pre, .code-block-wrapper, table, .table-wrapper, .markdown-alert, .mermaid-diagram-wrap, blockquote {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    tr {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    :not(pre) > code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 9.5pt;
      background-color: #f1f5f9;
      padding: 2px 5px;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
      color: #0f172a;
    }
    .code-block-wrapper {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #f8fafc;
