---
export interface Props {
  sideBarActiveItemID?: string;
}

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300";

const mainLinks = [
  { id: "home", href: "/", label: "Home" },
  { id: "projects", href: "/projects", label: "Projects" },
  { id: "services", href: "/services", label: "Services" },
  { id: "blog", href: "/blog/", label: "Blog" },
  { id: "cv", href: "/cv", label: "CV" },
  { id: "contact", href: "/contact", label: "Contact" },
];

const labLinks = [
  { id: "playground", href: "/playground", label: "Playground" },
  { id: "videos", href: "/videos", label: "Drone & Aerial" },
];
---

<nav aria-label="Primary" class="grow shrink overflow-y-auto">
  <ul class="menu w-full menu-md">
    {
      mainLinks.map(({ id, href, label }) => {
        const isActive = sideBarActiveItemID === id;
        return (
          <li>
            <a
              class:list={["py-3 text-base", { [activeClass]: isActive }]}
              id={id}
              href={href}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })
    }

    <li class="pointer-events-none my-1 p-0" aria-hidden="true">
      <div class="divider my-0 w-full">Lab</div>
    </li>

    {
      labLinks.map(({ id, href, label }) => {
        const isActive = sideBarActiveItemID === id;
        return (
          <li>
            <a
              class:list={["py-3 text-base", { [activeClass]: isActive }]}
              id={id}
              href={href}
              aria-current={isActive ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
