---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Drone Work & Aerial Cinematography" sideBarActiveItemID="videos">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Drone Work & Aerial Cinematography</div>
  </div>

  <div class="mb-10 text-justify">
    <div class="badge badge-secondary mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-4 h-4 stroke-current mr-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"></path></svg>
      FAA Part 107 Commercial Drone Remote Pilot
    </div>
    <p class="mb-6 text-lg">
      4K cinematic aerial footage, active tracking, industrial tower inspections, and stock footage filmed across Washington & Montana.
    </p>

    <!-- Flight Operations & Safety Standards -->
    <div class="card bg-base-200 shadow-xl mb-10">
      <div class="card-body">
        <h2 class="card-title text-xl text-primary mb-2">🛡️ Flight Operations & Safety Standards</h2>
        <ul class="list-disc mx-6 grid gap-2">
          <li>FAA Part 107 Certified Remote Pilot with active airspace authorization</li>
          <li>Pre-flight weather assessment, NOTAM review, and risk mitigation protocols</li>
          <li>Full liability insurance coverage for all commercial flight missions</li>
          <li>Calibrated 4K D-Log video capture for maximum post-production dynamic range</li>
        </ul>
        <div class="card-actions justify-start mt-4">
          <a href="https://www.youtube.com/@Life2freedom" target="_blank" rel="noopener" class="btn btn-primary">Watch More on YouTube</a>
          <a href="/contact" class="btn btn-outline">Inquire About Services</a>
        </div>
      </div>
    </div>

    <!-- Video Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- Frazier Lake -->
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-4 pt-4">
          <div class="w-full relative pb-[56.25%] h-0 rounded-xl overflow-hidden bg-black">
            <iframe src="https://www.youtube-nocookie.com/embed/1RAT7dSdrPk" title="Frazier Lake - Cinematic 4K Drone Footage" class="absolute top-0 left-0 w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </figure>
        <div class="card-body">
          <h3 class="card-title text-lg">
            <a href="https://www.youtube.com/watch?v=1RAT7dSdrPk" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
              Frazier Lake — Cinematic 4K
            </a>
          </h3>
          <p class="text-sm">Sweeping aerial views over Frazier Lake with smooth push-in reveals and natural landscape lighting.</p>
          <div class="card-actions justify-end mt-2">
            <div class="badge badge-outline">4K UHD</div>
            <div class="badge badge-outline">Landscape</div>
          </div>
        </div>
      </div>

      <!-- Active Track DJI Air 2S -->
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-4 pt-4">
          <div class="w-full relative pb-[56.25%] h-0 rounded-xl overflow-hidden bg-black">
            <iframe src="https://www.youtube-nocookie.com/embed/ikiPAH_JGgM" title="Active Track DJI Air 2S Cinematic 4K Footage" class="absolute top-0 left-0 w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </figure>
        <div class="card-body">
          <h3 class="card-title text-lg">
            <a href="https://www.youtube.com/watch?v=ikiPAH_JGgM" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
              Active Track — DJI Air 2S
            </a>
          </h3>
          <p class="text-sm">Dynamic subject tracking demonstration using DJI Air 2S sensor suite and smooth flight control.</p>
          <div class="card-actions justify-end mt-2">
            <div class="badge badge-outline">4K UHD</div>
            <div class="badge badge-outline">Active Track</div>
          </div>
        </div>
      </div>

      <!-- Cattail Pond Ice Cleaning Crew -->
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-4 pt-4">
          <div class="w-full relative pb-[56.25%] h-0 rounded-xl overflow-hidden bg-black">
            <iframe src="https://www.youtube-nocookie.com/embed/W4LO1_BeBsI" title="Cattail Pond Ice Cleaning Crew 4K Drone Video" class="absolute top-0 left-0 w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </figure>
        <div class="card-body">
          <h3 class="card-title text-lg">
            <a href="https://www.youtube.com/watch?v=W4LO1_BeBsI" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
              Cattail Pond — Ice Cleaning
            </a>
          </h3>
          <p class="text-sm">Winter action footage capturing the ice cleaning crew operations on Cattail Pond from low aerial angles.</p>
          <div class="card-actions justify-end mt-2">
            <div class="badge badge-outline">4K UHD</div>
            <div class="badge badge-outline">Winter Action</div>
          </div>
        </div>
      </div>

      <!-- Cattail Pond Winter Sunrise -->
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-4 pt-4">
          <div class="w-full relative pb-[56.25%] h-0 rounded-xl overflow-hidden bg-black">
            <iframe src="https://www.youtube-nocookie.com/embed/-yqcvhoB6Cs" title="Cattail Pond Sunrise" class="absolute top-0 left-0 w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </figure>
        <div class="card-body">
          <h3 class="card-title text-lg">
            <a href="https://www.youtube.com/watch?v=-yqcvhoB6Cs" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
              Cattail Pond Winter Sunrise
            </a>
          </h3>
          <p class="text-sm">Soft winter palette and gradual reveal of Cattail Pond under early morning sun. Low-angle exposure control.</p>
          <div class="card-actions justify-end mt-2">
            <div class="badge badge-outline">4K UHD</div>
            <div class="badge badge-outline">Landscape</div>
          </div>
        </div>
      </div>

      <!-- Bozeman MT Summer Stock -->
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-4 pt-4">
          <div class="w-full relative pb-[56.25%] h-0 rounded-xl overflow-hidden bg-black">
            <iframe src="https://www.youtube-nocookie.com/embed/UzItAFlkepA" title="Bozeman MT Summer 4K" class="absolute top-0 left-0 w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </figure>
        <div class="card-body">
          <h3 class="card-title text-lg">
            <a href="https://www.youtube.com/watch?v=UzItAFlkepA" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
              Bozeman, MT Summer Stock
            </a>
          </h3>
          <p class="text-sm">Valley expanses, mountain ridgelines, and commercial stock shots designed for promotional overlays.</p>
          <div class="card-actions justify-end mt-2">
            <div class="badge badge-outline">4K UHD</div>
            <div class="badge badge-outline">Montana</div>
          </div>
        </div>
      </div>

      <!-- 100ft WISP Tower -->
      <div class="card bg-base-100 shadow-xl">
        <figure class="px-4 pt-4">
          <div class="w-full relative pb-[56.25%] h-0 rounded-xl overflow-hidden bg-black">
            <iframe src="https://www.youtube-nocookie.com/embed/vpCcIjhkdK8" title="100ft WISP Tower Climber" class="absolute top-0 left-0 w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </figure>
        <div class="card-body">
          <h3 class="card-title text-lg">
            <a href="https://www.youtube.com/watch?v=vpCcIjhkdK8" target="_blank" rel="noopener" class="hover:text-primary transition-colors">
              100ft WISP Tower & Climber
            </a>
          </h3>
          <p class="text-sm">Precision lateral & vertical tracking of WISP tower ascent with smooth parallax and safe separation distance.</p>
          <div class="card-actions justify-end mt-2">
            <div class="badge badge-outline">4K UHD</div>
            <div class="badge badge-outline">Industrial</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
